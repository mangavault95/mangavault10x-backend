# Copia in .env per lo sviluppo locale.
# In produzione questi valori vanno nelle Environment Variables di Render.
# NON committare mai il file .env con i valori reali.

# --- Database (Supabase) ---
DATABASE_URL=postgresql://utente:password@host:5432/postgres

# --- Autenticazione del proprietario ---
# Genera hash e secret con: node scripts/hash-password.js "la-tua-password"
#
# Solo il proprietario ha le credenziali qui: gli altri utenti vivono
# nella tabella `utenti` e si registrano dal sito (vedi sql/009). A ogni
# avvio il server riversa questi valori nella riga del proprietario.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Il nome che compare accanto ai voti: "Voto Nicer".
ADMIN_NICKNAME=Nicer
JWT_SECRET=
# Trenta giorni: la sessione non dice più solo cosa puoi salvare, ma
# quali voti e quali letture stai guardando. Scadere in un pomeriggio
# significherebbe ritrovarsi nella biblioteca di un altro.
JWT_TTL=30d

# --- CORS: domini autorizzati, separati da virgola ---
ALLOWED_ORIGINS=https://mangavault10x-frontend.vercel.app

# --- Job schedulato (GitHub Actions) ---
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Va copiato anche fra i Secrets del repo GitHub, con lo stesso nome.
CRON_SECRET=

# --- Traduzione delle trame (MyMemory, gratuito) ---
# Un'email valida alza la quota da 5.000 a 50.000 caratteri al giorno.
# Non serve registrarsi: l'indirizzo viene solo inviato a MyMemory
# a ogni richiesta come identificativo.
MYMEMORY_EMAIL=

# --- Google Books: trame in italiano, editore, ISBN, prezzo copertina ---
# Chiave gratuita (1000 richieste/giorno) da console.cloud.google.com
# Senza chiave l'API risponde 429 e si ripiega su AniList (inglese).
GOOGLE_BOOKS_API_KEY=

# --- eBay (opzionale, per i prezzi di mercato) ---
# Credenziali gratuite da https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Bot delle uscite (@Videoteca10xBot) ---
# Il token te lo dà @BotFather con /newbot. Questo bot MANDA e basta:
# non ha un webhook, non riceve niente, e senza token gli avvisi
# semplicemente non partono (la rotta lo dice con un errore chiaro).
TELEGRAM_USCITE_TOKEN=

# L'indirizzo del sito, per i link dentro i messaggi Telegram.
# Se manca vale https://mangavault10x-frontend.vercel.app
SITO_URL=https://mangavault10x-frontend.vercel.app
